PORT=3000
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Development-only migration fallback. Do not use in a public deployment.
ENCRYPTION_KEY=
# Required in production. Use different long random values for each key.
DATA_ENCRYPTION_KEY=
SESSION_SECRET=
# Google OAuth web client ID for sign-in.
GOOGLE_CLIENT_ID=
# Required private-beta access code. Keep this only in your host's secret store.
INVITE_CODE=
# Set to production when deployed so session cookies are HTTPS-only.
NODE_ENV=development
# For a one-time migration of the existing single-user local store, set this
# to the Google address that owns that existing data. Leave blank for a new app.
OWNER_EMAIL=
# Address shown on the legal and in-app support pages. Use a dedicated support
# inbox before inviting beta testers.
SUPPORT_EMAIL=
# On Railway, point this at its persistent volume mount, for example /data.
DATA_DIR=
# Railway supplies this privately from the Postgres service.
DATABASE_URL=
# Optional public webhook URL, e.g. https://your-domain.com/api/plaid/webhook
PLAID_WEBHOOK_URL=
MARKETDATA_API_TOKEN=
# Free tier supports one year of automatic investment reconstruction.
MARKETDATA_HISTORY_YEARS=1
# Leave true only for local development. Production must set this to false.
DEMO_MODE=true
