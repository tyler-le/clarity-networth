PORT=3000
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Use a long random string in production. Used to encrypt Plaid access tokens at rest.
ENCRYPTION_KEY=replace-me-with-a-long-random-secret
# Google OAuth web client ID for sign-in.
GOOGLE_CLIENT_ID=
# Optional comma-separated Google emails permitted to sign in. Leave blank to allow any verified Google account.
ALLOWED_EMAILS=
# Set to production when deployed so session cookies are HTTPS-only.
NODE_ENV=development
# For a one-time migration of the existing single-user local store, set this
# to the Google address that owns that existing data. Leave blank for a new app.
OWNER_EMAIL=
# On Railway, point this at its persistent volume mount, for example /data.
DATA_DIR=
# Optional public webhook URL, e.g. https://your-domain.com/api/plaid/webhook
PLAID_WEBHOOK_URL=
# Leave true to start with sample data. Set false for a blank app.
DEMO_MODE=true
